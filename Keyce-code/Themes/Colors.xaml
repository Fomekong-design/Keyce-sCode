<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackground"
            Color="#17191F"/>
    <SolidColorBrush x:Key="SidebarBackground"
            Color="#20232B"/>
    <SolidColorBrush x:Key="PanelBackground"
            Color="#252934"/>
    <SolidColorBrush x:Key="EditorBackground"
            Color="#191C23"/>
    <SolidColorBrush x:Key="BorderBrush"
            Color="#343946"/>

    <SolidColorBrush x:Key="PrimaryText"
            Color="#E6E8EF"/>
    <SolidColorBrush x:Key="SecondaryText"
            Color="#969EAE"/>

    <SolidColorBrush x:Key="AccentBrush"
            Color="#6C8CFF"/>
    <SolidColorBrush x:Key="SuccessBrush"
            Color="#43B581"/>
    <SolidColorBrush x:Key="ErrorBrush"
            Color="#F16C75"/>

</ResourceDictionary>