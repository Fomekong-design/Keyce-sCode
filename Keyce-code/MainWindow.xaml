<Window x:Class="Keyce_code.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KEYCE CODE"
        Height="850"
        Width="1450"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <!-- APPLICATION TITLE -->
        <Border Grid.Row="0"
                Background="#20232B"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">

            <DockPanel Margin="12,0">

                <TextBlock Text="KEYCE CODE"
                           FontSize="13"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="#FFFFFF"/>

                <TextBlock Text="  •  Development Environment"
                           Foreground="{StaticResource SecondaryText}"
                           FontSize="11"
                           VerticalAlignment="Center"/>

            </DockPanel>
        </Border>

        <!-- MENU BAR -->
        <Border Grid.Row="1"
                Background="{StaticResource SidebarBackground}">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="10,0">

                <Menu Background="Transparent"
                      Foreground="{StaticResource PrimaryText}">

                    <MenuItem Header="_File"/>
                    <MenuItem Header="_Edit"/>
                    <MenuItem Header="_Selection"/>
                    <MenuItem Header="_View"/>
                    <MenuItem Header="_Run"/>
                    <MenuItem Header="_Terminal"/>
                    <MenuItem Header="_Help"/>

                </Menu>

            </StackPanel>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ACTIVITY BAR -->
            <Border Grid.Column="0"
                    Background="#20232B">

                <StackPanel HorizontalAlignment="Center"
                            Margin="0,15">

                    <TextBlock Text="▤"
                               FontSize="24"
                               Margin="0,8"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="⌕"
                               FontSize="25"
                               Margin="0,8"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="⑂"
                               FontSize="24"
                               Margin="0,8"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="▦"
                               FontSize="23"
                               Margin="0,8"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="⚙"
                               FontSize="23"
                               Margin="0,8"
                               HorizontalAlignment="Center"/>

                </StackPanel>
            </Border>

            <!-- EXPLORER -->
            <Border Grid.Column="1"
                    Background="{StaticResource SidebarBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">

                <DockPanel Margin="15">

                    <TextBlock Text="EXPLORER"
                               Style="{StaticResource PanelTitle}"
                               DockPanel.Dock="Top"
                               Margin="0,0,0,20"/>

                    <StackPanel>

                        <TextBlock Text="⌄  KEYCE CODE"
                                   FontWeight="SemiBold"
                                   Margin="0,5"/>

                        <TextBlock Text="    📁 Assets"
                                   Margin="0,5"
                                   Foreground="{StaticResource SecondaryText}"/>

                        <TextBlock Text="    📁 Controls"
                                   Margin="0,5"
                                   Foreground="{StaticResource SecondaryText}"/>

                        <TextBlock Text="    📁 Services"
                                   Margin="0,5"
                                   Foreground="{StaticResource SecondaryText}"/>

                        <TextBlock Text="    📁 Themes"
                                   Margin="0,5"
                                   Foreground="{StaticResource SecondaryText}"/>

                        <TextBlock Text="    📁 Views"
                                   Margin="0,5"
                                   Foreground="{StaticResource SecondaryText}"/>

                        <TextBlock Text="    📄 App.xaml"
                                   Margin="0,5"/>

                        <TextBlock Text="    📄 MainWindow.xaml"
                                   Margin="0,5"/>

                    </StackPanel>

                </DockPanel>
            </Border>

            <!-- EDITOR WORKSPACE -->
            <Grid Grid.Column="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- EDITOR TABS -->
                <Border Grid.Row="0"
                        Background="{StaticResource PanelBackground}">

                    <TextBlock Text="Welcome"
                               VerticalAlignment="Center"
                               Margin="15,0"
                               FontSize="12"/>

                </Border>

                <!-- EDITOR CONTENT -->
                <Border Grid.Row="1"
                        Background="{StaticResource EditorBackground}">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="KEYCE CODE"
                                   FontSize="38"
                                   FontWeight="Bold"
                                   Foreground="#6C8CFF"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Your code. Your environment."
                                   FontSize="14"
                                   Foreground="{StaticResource SecondaryText}"
                                   Margin="0,10"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="A new way to develop."
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryText}"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Grid>

        <!-- BOTTOM PANEL -->
        <Border Grid.Row="3"
                Background="{StaticResource SidebarBackground}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">

            <DockPanel Margin="15">

                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Margin="0,0,0,15">

                    <TextBlock Text="PROBLEMS"
                               Style="{StaticResource PanelTitle}"
                               Margin="0,0,20,0"/>

                    <TextBlock Text="OUTPUT"
                               Style="{StaticResource PanelTitle}"
                               Margin="0,0,20,0"/>

                    <TextBlock Text="DEBUG CONSOLE"
                               Style="{StaticResource PanelTitle}"
                               Margin="0,0,20,0"/>

                    <TextBlock Text="TERMINAL"
                               Foreground="{StaticResource AccentBrush}"
                               FontWeight="Bold"
                               FontSize="11"/>

                </StackPanel>

                <TextBlock Text="Terminal will appear here..."
                           Foreground="{StaticResource SecondaryText}"
                           FontFamily="Consolas"
                           FontSize="12"/>

            </DockPanel>

        </Border>

        <!-- STATUS BAR -->
        <Border Grid.Row="4"
                Background="#303C65">

            <DockPanel Margin="10,0">

                <TextBlock Text="⑂ feature/keyce-code-development"
                           VerticalAlignment="Center"
                           FontSize="10"/>

                <TextBlock Text="KEYCE CODE  |  Ready"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="10"/>

            </DockPanel>

        </Border>

    </Grid>

</Window>